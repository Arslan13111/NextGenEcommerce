<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Push Notification Permission (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Storage Permissions -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- Camera Permission -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Features -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />

    <application
        android:name=".NextGenEcommerceApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.NextGenEcommerce"
        android:usesCleartextTraffic="${usesCleartextTraffic}"
        tools:targetApi="31">

        <!-- Snap Camera Kit API token is supplied from local.properties or CI. -->
        <meta-data
            android:name="com.snap.camerakit.api.token"
            android:value="${snapCameraKitApiToken}" />

        <!-- Main Compose Activity (New Launcher) -->
        <activity
            android:name=".presentation.MainComposeActivity"
            android:exported="true"
            android:theme="@style/Theme.NextGenEcommerce"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Live AR Try-On Activity (Snap Camera Kit) -->
        <activity
            android:name=".presentation.screens.tryon.LiveARTryOnActivity"
            android:exported="false"
            android:theme="@style/Theme.NextGenEcommerce"
            android:screenOrientation="portrait" />

        <!-- Firebase Cloud Messaging Service -->
        <service
            android:name=".service.NextGenFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>

</manifest>
