<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Header Section -->
        <TextView
            android:id="@+id/txtHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Virtual Try-On"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#212121"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/txtSubheader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="See how this item looks on you"
            android:textSize="14sp"
            android:textColor="#757575"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/txtHeader"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Clothing Image Section -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardClothing"
            android:layout_width="0dp"
            android:layout_height="200dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:strokeWidth="1dp"
            app:strokeColor="#E0E0E0"
            app:layout_constraintTop_toBottomOf="@id/txtSubheader"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/cardAvatar"
            app:layout_constraintWidth_percent="0.48">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/imgClothing"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:background="#FAFAFA"
                    android:contentDescription="Clothing image"
                    tools:src="@android:drawable/ic_menu_gallery"/>

                <TextView
                    android:id="@+id/txtClothingLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Product"
                    android:textSize="12sp"
                    android:textColor="@android:color/white"
                    android:background="#80000000"
                    android:padding="8dp"
                    android:gravity="center"
                    android:layout_alignParentBottom="true"/>
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Avatar Image Section -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAvatar"
            android:layout_width="0dp"
            android:layout_height="200dp"
            android:layout_marginTop="24dp"
            android:layout_marginStart="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:strokeWidth="1dp"
            app:strokeColor="#E0E0E0"
            app:layout_constraintTop_toBottomOf="@id/txtSubheader"
            app:layout_constraintStart_toEndOf="@id/cardClothing"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintWidth_percent="0.48">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/imgAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:background="#FAFAFA"
                    android:contentDescription="Your photo"
                    tools:src="@android:drawable/ic_menu_gallery"/>

                <TextView
                    android:id="@+id/txtAvatarLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Your Photo"
                    android:textSize="12sp"
                    android:textColor="@android:color/white"
                    android:background="#80000000"
                    android:padding="8dp"
                    android:gravity="center"
                    android:layout_alignParentBottom="true"/>
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Image Selection Buttons -->
        <Button
            android:id="@+id/btnSelectClothing"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Change Product"
            android:textSize="12sp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#757575"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/cardClothing"
            app:layout_constraintStart_toStartOf="@id/cardClothing"
            app:layout_constraintEnd_toEndOf="@id/cardClothing"/>

        <Button
            android:id="@+id/btnSelectAvatar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Upload Your Photo"
            android:textSize="12sp"
            android:layout_marginTop="8dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#2196F3"
            app:layout_constraintTop_toBottomOf="@id/cardAvatar"
            app:layout_constraintStart_toStartOf="@id/cardAvatar"
            app:layout_constraintEnd_toEndOf="@id/cardAvatar"/>

        <!-- Camera Button -->
        <Button
            android:id="@+id/btnUseCamera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📷 Use Camera"
            android:drawableLeft="@android:drawable/ic_menu_camera"
            android:drawablePadding="8dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#FF9800"
            app:layout_constraintTop_toBottomOf="@id/btnSelectAvatar"/>

        <!-- Try On Button -->
        <Button
            android:id="@+id/btnTryOn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="✨ Try On This Product"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:backgroundTint="#4CAF50"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/btnUseCamera"
            tools:visibility="visible"/>

        <!-- Progress Section -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:visibility="gone"
            android:layout_marginTop="24dp"
            android:indeterminateTint="#4CAF50"
            app:layout_constraintTop_toBottomOf="@id/btnTryOn"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:visibility="visible"/>

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Processing with AI... This may take 30-60 seconds"
            android:textSize="14sp"
            android:textColor="#757575"
            android:visibility="gone"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:maxWidth="300dp"
            app:layout_constraintTop_toBottomOf="@id/progressBar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:visibility="visible"/>

        <!-- Retry Button -->
        <Button
            android:id="@+id/btnRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Retry"
            android:visibility="gone"
            android:layout_marginTop="16dp"
            android:backgroundTint="#FF5722"
            app:layout_constraintTop_toBottomOf="@id/txtStatus"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:visibility="visible"/>

        <!-- Result Section -->
        <TextView
            android:id="@+id/txtResultLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Try-On Result"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#212121"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@id/btnRetry"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/txtResultSubtext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI-generated preview"
            android:textSize="12sp"
            android:textColor="#757575"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/txtResultLabel"
            app:layout_constraintStart_toStartOf="parent"/>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardResult"
            android:layout_width="match_parent"
            android:layout_height="400dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:strokeWidth="2dp"
            app:strokeColor="#4CAF50"
            app:layout_constraintTop_toBottomOf="@id/txtResultSubtext">

            <ImageView
                android:id="@+id/imgResult"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="#FAFAFA"
                android:visibility="gone"
                android:contentDescription="Try-on result"
                tools:src="@android:drawable/ic_menu_gallery"
                tools:visibility="visible"/>

            <TextView
                android:id="@+id/txtResultPlaceholder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Your result will appear here"
                android:textSize="16sp"
                android:textColor="#BDBDBD"
                android:gravity="center"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- Bottom Spacing -->
        <View
            android:id="@+id/bottomSpacer"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            app:layout_constraintTop_toBottomOf="@id/cardResult"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
